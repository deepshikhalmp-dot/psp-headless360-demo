<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Runs the PSP Program FAQ Answer prompt template, which is grounded on the PSP Program FAQ data library (Data 360 retriever).</description>
        <name>Ask_Program_FAQ</name>
        <label>Ask Program FAQ</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <actionName>PSP_Program_FAQ_Answer</actionName>
        <actionType>generatePromptResponse</actionType>
        <connector>
            <targetReference>Set_Success</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Error</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>Input:question</name>
            <value>
                <elementReference>question</elementReference>
            </value>
        </inputParameters>
        <outputParameters>
            <assignToReference>answer</assignToReference>
            <name>promptResponse</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>68.0</apiVersion>
    <assignments>
        <name>Set_Error</name>
        <label>Set Error</label>
        <locationX>578</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>isSuccess</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>resultCode</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>ERROR</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>resultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxErrorMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Success</name>
        <label>Set Success</label>
        <locationX>314</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>isSuccess</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>resultCode</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>SUCCESS</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>resultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Answer generated from the Zenthera Program FAQ (fictional demo content). Show the answer to the user as written.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Validation_Error</name>
        <label>Set Validation Error</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>isSuccess</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>resultCode</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>VALIDATION_ERROR</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>resultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Please ask a program question (1 to 1000 characters).</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Question</name>
        <label>Check Question</label>
        <locationX>182</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Ask_Program_FAQ</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Valid</defaultConnectorLabel>
        <rules>
            <name>Question_Invalid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fxQuestionInvalid</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Validation_Error</targetReference>
            </connector>
            <label>Question Invalid</label>
        </rules>
    </decisions>
    <description>Zenthera Patient Support Program (demo, fictional data). Answers a program question (eligibility, enrollment, copay and insurance support, shipments and refills, contact, privacy) using the PSP Program FAQ Answer prompt template, grounded on the PSP Program FAQ data library. No medical advice. Exposed as an MCP tool and reusable as an Agentforce action.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxErrorMessage</name>
        <dataType>String</dataType>
        <expression>&quot;The program FAQ could not be searched right now. Please try again or contact the program team. Details: &quot; &amp; {!$Flow.FaultMessage}</expression>
    </formulas>
    <formulas>
        <name>fxQuestionInvalid</name>
        <dataType>Boolean</dataType>
        <expression>OR(ISBLANK(TRIM({!question})), LEN({!question}) &gt; 1000)</expression>
    </formulas>
    <interviewLabel>PSP Answer Program Question {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PSP Answer Program Question</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Question</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>Answer text from the prompt template. Show it to the user as written.</description>
        <name>answer</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>isSuccess</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <description>The program question in the user's words, for example about eligibility, copay assistance, insurance, shipments, refills or how to contact the program.</description>
        <name>question</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>SUCCESS, VALIDATION_ERROR or ERROR.</description>
        <name>resultCode</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>resultMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
