                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Patients_By_Id</targetReference>
            </connector>
            <label>By Id</label>
        </rules>
    </decisions>
    <decisions>
        <description>0 = not found, more than 1 = ambiguous (never pick one silently), 1 = continue.</description>
        <name>Match_Count</name>
        <label>Match Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Patients</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>One Match</defaultConnectorLabel>
        <rules>
            <name>No_Match</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varMatchCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Not_Found</targetReference>
            </connector>
            <label>No Match</label>
        </rules>
        <rules>
            <name>Several_Matches</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varMatchCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Ambiguous</targetReference>
            </connector>
            <label>Several Matches</label>
        </rules>
    </decisions>
    <decisions>
        <description>The patient must have a program enrollment that is not Discontinued.</description>
        <name>Has_Enrollment</name>
        <label>Has Enrollment</label>
        <locationX>0</locationX>
