    <decisions>
        <description>Stops before any lookup or DML when inputs are invalid. Continues only when userConfirmed is exactly true; blank or false creates nothing.</description>
        <name>Check_Inputs</name>
        <label>Check Inputs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Not_Confirmed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Confirmed</defaultConnectorLabel>
        <rules>
            <name>Inputs_Invalid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fxHasInvalidInput</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
