                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_No_Enrollment</targetReference>
            </connector>
            <label>Not Enrolled</label>
        </rules>
    </decisions>
    <description>Zenthera PSP demo (fictional data). Creates ONE standard Case for an enrolled patient after explicit user confirmation. Finds the patient by Account Id or exact name, refuses unknown or ambiguous patients, links the Case to the Person Account, sets Status New and Origin Slack. Possible adverse events are flagged for human safety review only; no medical advice and no automatic regulatory reporting.</description>
    <formulas>
        <description>TRUE when a required input is missing or a value is not allowed.</description>
        <name>fxHasInvalidInput</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    AND(ISBLANK({!patientName}), ISBLANK({!patientAccountId})),
    ISBLANK({!subject}),
    ISBLANK({!description}),
    ISBLANK({!issueCategory}),
    AND(NOT(ISBLANK({!issueCategory})), {!issueCategory} &lt;&gt; &quot;Shipment Delay&quot;, {!issueCategory} &lt;&gt; &quot;Refill Support&quot;, {!issueCategory} &lt;&gt; &quot;Insurance Support&quot;, {!issueCategory} &lt;&gt; &quot;General Program Support&quot;, {!issueCategory} &lt;&gt; &quot;Possible Adverse Event&quot;),
    LEN({!subject}) &gt; 200,
    AND(NOT(ISBLANK({!patientAccountId})), LEN({!patientAccountId}) &lt;&gt; 15, LEN({!patientAccountId}) &lt;&gt; 18)
)</expression>
    </formulas>
    <formulas>
        <description>Lists every missing or invalid input.</description>
        <name>fxValidationMessage</name>
        <dataType>String</dataType>
        <expression>&quot;No case was created. &quot;
&amp; IF(AND(ISBLANK({!patientName}), ISBLANK({!patientAccountId})), &quot;Patient name (or patient Account Id) is required. &quot;, &quot;&quot;)
&amp; IF(ISBLANK({!subject}), &quot;Subject is required. &quot;, &quot;&quot;)
&amp; IF(ISBLANK({!description}), &quot;Description is required. &quot;, &quot;&quot;)
&amp; IF(ISBLANK({!issueCategory}), &quot;Issue category is required. &quot;, &quot;&quot;)
&amp; IF(AND(NOT(ISBLANK({!issueCategory})), {!issueCategory} &lt;&gt; &quot;Shipment Delay&quot;, {!issueCategory} &lt;&gt; &quot;Refill Support&quot;, {!issueCategory} &lt;&gt; &quot;Insurance Support&quot;, {!issueCategory} &lt;&gt; &quot;General Program Support&quot;, {!issueCategory} &lt;&gt; &quot;Possible Adverse Event&quot;), &quot;Issue category must be Shipment Delay, Refill Support, Insurance Support, General Program Support or Possible Adverse Event. &quot;, &quot;&quot;)
&amp; IF(LEN({!subject}) &gt; 200, &quot;Subject must be 200 characters or fewer. &quot;, &quot;&quot;)
&amp; IF(AND(NOT(ISBLANK({!patientAccountId})), LEN({!patientAccountId}) &lt;&gt; 15, LEN({!patientAccountId}) &lt;&gt; 18), &quot;Patient Account Id must be a 15 or 18 character Salesforce Id. &quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fxUseAccountId</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!patientAccountId}))</expression>
    </formulas>
    <formulas>
        <name>fxIsAdverseEvent</name>
        <dataType>Boolean</dataType>
        <expression>{!issueCategory} = &quot;Possible Adverse Event&quot;</expression>
    </formulas>
    <formulas>
        <description>Case subject with the category in brackets; possible adverse events are marked for safety review.</description>
        <name>fxCaseSubject</name>
        <dataType>String</dataType>
        <expression>IF({!fxIsAdverseEvent}, &quot;[SAFETY REVIEW] Possible Adverse Event - &quot;, &quot;[&quot; &amp; {!issueCategory} &amp; &quot;] &quot;) &amp; {!subject}</expression>
    </formulas>
    <formulas>
        <name>fxCasePriority</name>
        <dataType>String</dataType>
        <expression>IF({!fxIsAdverseEvent}, &quot;High&quot;, &quot;Medium&quot;)</expression>
    </formulas>
    <formulas>
        <description>Maps the PSP category to an existing Case Type value.</description>
        <name>fxCaseType</name>
        <dataType>String</dataType>
        <expression>CASE({!issueCategory}, &quot;Insurance Support&quot;, &quot;Account Support&quot;, &quot;General Program Support&quot;, &quot;General&quot;, &quot;Product Support&quot;)</expression>
    </formulas>
    <formulas>
        <name>fxSafetyNote</name>
        <dataType>String</dataType>
        <expression>IF({!fxIsAdverseEvent}, &quot;SAFETY REVIEW REQUIRED: possible adverse event reported. Route to the safety / pharmacovigilance team for human review. No medical advice was given and no regulatory report has been submitted automatically.&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fxNotFoundMessage</name>
        <dataType>String</dataType>
        <expression>&quot;No case was created: no patient found for &quot; &amp; IF(ISBLANK({!patientAccountId}), &quot;the name &quot; &amp; {!patientName}, &quot;Account Id &quot; &amp; {!patientAccountId}) &amp; &quot;. Check the full name as recorded in Salesforce.&quot;</expression>
    </formulas>
    <formulas>
        <name>fxAmbiguousMessage</name>
        <dataType>String</dataType>
        <expression>&quot;No case was created: &quot; &amp; TEXT({!varMatchCount}) &amp; &quot; patients are named &quot; &amp; {!patientName} &amp; &quot;. Ask the user which patient is meant and call again with patientAccountId.&quot;</expression>
    </formulas>
    <formulas>
        <name>fxNoEnrollmentMessage</name>
        <dataType>String</dataType>
        <expression>&quot;No case was created: &quot; &amp; {!varPatientDisplayName} &amp; &quot; has no active enrollment in the Zenthera Patient Support Program.&quot;</expression>
    </formulas>
    <formulas>
        <name>fxLookupFaultMessage</name>
        <dataType>String</dataType>
        <expression>&quot;No case was created: the patient lookup failed. Details: &quot; &amp; {!$Flow.FaultMessage}</expression>
    </formulas>
    <formulas>
        <name>fxCreateFaultMessage</name>
        <dataType>String</dataType>
        <expression>&quot;No case was created: Salesforce could not save the case. Details: &quot; &amp; {!$Flow.FaultMessage}</expression>
    </formulas>
    <formulas>
        <name>fxSuccessMessage</name>
        <dataType>String</dataType>
        <expression>&quot;Case &quot; &amp; {!Get_Created_Case.CaseNumber} &amp; &quot; created for &quot; &amp; {!varPatientDisplayName} &amp; &quot; (&quot; &amp; {!Get_Enrollment.Name} &amp; &quot;), status &quot; &amp; TEXT({!Get_Created_Case.Status}) &amp; &quot;, priority &quot; &amp; TEXT({!Get_Created_Case.Priority}) &amp; &quot;.&quot; &amp; IF({!fxIsAdverseEvent}, &quot; Flagged for human safety review. No medical advice is given and no regulatory report has been submitted automatically.&quot;, &quot;&quot;)</expression>
    </formulas>
