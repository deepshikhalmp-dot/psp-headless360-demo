            <fullName>get_program_exceptions_179gL000003AU39</fullName>
            <description>Read-only. Lists PSP program exceptions from CRM data, most severe first. Optional filters: one enrollment number and a comma separated list of exception types (REFILL_OVERDUE, REFILL_DUE_SOON, SHIPMENT_DELAYED, SHIPPED_NOT_DELIVERED, NO_SHIPMENT_RECORDED, CONSENT_PENDING, SAFETY_REVIEW_OPEN, DUPLICATE_OPEN_CASES, UNCATEGORISED_OPEN_CASE, DATA_INCOMPLETE). Patients without exceptions are not listed.</description>
            <developerName>get_program_exceptions_179gL000003AU39</developerName>
            <invocationTarget>PSP_ProgramExceptionsService</invocationTarget>
            <invocationTargetType>apex</invocationTargetType>
            <isConfirmationRequired>false</isConfirmationRequired>
            <isIncludeInProgressIndicator>false</isIncludeInProgressIndicator>
            <localDeveloperName>get_program_exceptions</localDeveloperName>
            <masterLabel>Get Program Exceptions</masterLabel>
        </localActions>
        <localActions>
            <fullName>get_worklist_card_179gL000003AU39</fullName>
            <description>Read-only. Shows today&apos;s PSP program exceptions as a worklist card (counts by severity and the items grouped HIGH, MEDIUM, LOW and data gaps). Optional filters: one enrollment number and comma separated exception types.</description>
